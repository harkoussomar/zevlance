"use client";

import { useState } from "react";
import {
    User,
    Mail,
    Phone,
    Globe,
    Building2,
    Pencil,
    Save,
    X,
    Check,
    Briefcase,
    DollarSign,
    BadgeCheck,
} from "lucide-react";
import {
    MOCK_FREELANCER,
    MOCK_CLIENT,
    MOCK_REVIEWS,
    MOCK_CONTRACTS,
} from "@/lib/mock-data";
import {  formatDate, cn } from "@/lib/utils";
import {
    Button,
    Input,
    Card,
    CardContent,
    CardHeader,
    CardTitle,
    Avatar,
    StatCard,
    StarRating,
    SkillTag,
    Separator,
    Alert,
} from "@/components/ui";
import {
    useIsFreelancer,
} from "@/store/auth-store";

// ─── Editable Field ───────────────────────────────────────────────────────────

function EditableField({
    label,
    value,
    onSave,
    multiline,
    type,
    icon,
}: {
    label: string;
    value: string;
    onSave: (v: string) => void;
    multiline?: boolean;
    type?: string;
    icon?: React.ReactNode;
}) {
    const [editing, setEditing] = useState(false);
    const [draft, setDraft] = useState(value);

    const handleSave = () => {
        onSave(draft);
        setEditing(false);
    };

    const handleCancel = () => {
        setDraft(value);
        setEditing(false);
    };

    return (
        <div className="group">
            {!editing ? (
                <div className="flex items-start justify-between gap-3">
                    <div className="flex items-start gap-2.5 min-w-0">
                        {icon && (
                            <span className="text-muted-foreground mt-0.5 shrink-0">
                                {icon}
                            </span>
                        )}
                        <div>
                            <p className="text-xs text-muted-foreground font-medium mb-0.5">
                                {label}
                            </p>
                            <p
                                className={cn(
                                    "text-sm text-foreground",
                                    !value && "italic text-muted-foreground/60",
                                )}
                            >
                                {value || "Not set"}
                            </p>
                        </div>
                    </div>
                    <button
                        onClick={() => setEditing(true)}
                        className="opacity-0 group-hover:opacity-100 p-1.5 rounded-lg hover:bg-muted text-muted-foreground transition-all shrink-0"
                    >
                        <Pencil className="w-3.5 h-3.5" />
                    </button>
                </div>
            ) : (
                <div className="space-y-2">
                    <label className="text-xs font-semibold text-foreground">
                        {label}
                    </label>
                    {multiline ? (
                        <textarea
                            className="flex min-h-20 w-full rounded-lg border border-input bg-background px-3 py-2 text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring resize-none"
                            value={draft}
                            onChange={(e) => setDraft(e.target.value)}
                            rows={3}
                            autoFocus
                        />
                    ) : (
                        <input
                            type={type ?? "text"}
                            className="flex h-10 w-full rounded-lg border border-input bg-background px-3 py-2 text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
                            value={draft}
                            onChange={(e) => setDraft(e.target.value)}
                            autoFocus
                        />
                    )}
                    <div className="flex gap-2">
                        <Button size="sm" onClick={handleSave}>
                            <Save className="w-3.5 h-3.5" /> Save
                        </Button>
                        <Button
                            size="sm"
                            variant="ghost"
                            onClick={handleCancel}
                        >
                            <X className="w-3.5 h-3.5" /> Cancel
                        </Button>
                    </div>
                </div>
            )}
        </div>
    );
}

// ─── Skill editor ─────────────────────────────────────────────────────────────

function SkillsEditor({
    skills,
    onChange,
}: {
    skills: string[];
    onChange: (s: string[]) => void;
}) {
    const [input, setInput] = useState("");

    const add = () => {
        const skill = input.trim();
        if (skill && !skills.includes(skill)) {
            onChange([...skills, skill]);
            setInput("");
        }
    };

    return (
        <div className="space-y-2">
            <label className="text-xs text-muted-foreground font-medium">
                Skills
            </label>
            <div className="flex flex-wrap gap-2 mb-2">
                {skills.map((s) => (
                    <SkillTag
                        key={s}
                        skill={s}
                        onRemove={() =>
                            onChange(skills.filter((sk) => sk !== s))
                        }
                    />
                ))}
            </div>
            <div className="flex gap-2">
                <Input
                    placeholder="Add skill…"
                    value={input}
                    onChange={(e) => setInput(e.target.value)}
                    onKeyDown={(e) => {
                        if (e.key === "Enter") {
                            e.preventDefault();
                            add();
                        }
                    }}
                    className="text-sm h-8"
                />
                <Button
                    size="sm"
                    variant="outline"
                    onClick={add}
                    disabled={!input.trim()}
                    className="h-8"
                >
                    Add
                </Button>
            </div>
        </div>
    );
}

// ─── Page ─────────────────────────────────────────────────────────────────────

export default function ProfilePage() {
    // const user = useCurrentUser();
    const isFreelancer = useIsFreelancer();
    // const isClient = useIsClient();

    // ─ Freelancer state ─
    const [fl, setFl] = useState(MOCK_FREELANCER);
    const updateFl = <K extends keyof typeof MOCK_FREELANCER>(
        k: K,
        v: (typeof MOCK_FREELANCER)[K],
    ) => setFl((f) => ({ ...f, [k]: v }));

    // ─ Client state ─
    const [cl, setCl] = useState(MOCK_CLIENT);
    const updateCl = <K extends keyof typeof MOCK_CLIENT>(
        k: K,
        v: (typeof MOCK_CLIENT)[K],
    ) => setCl((c) => ({ ...c, [k]: v }));

    const [saved, setSaved] = useState(false);
    const handleSave = () => {
        setSaved(true);
        setTimeout(() => setSaved(false), 2500);
    };

    const completedContracts = MOCK_CONTRACTS.filter(
        (c) => c.status === "COMPLETED",
    );

    if (isFreelancer) {
        return (
            <div className="space-y-6 max-w-4xl">
                <div className="flex items-start justify-between">
                    <div>
                        <h1 className="text-2xl font-bold text-foreground">
                            My Profile
                        </h1>
                        <p className="text-muted-foreground mt-1">
                            Your public freelancer profile seen by clients.
                        </p>
                    </div>
                    <Button size="sm" onClick={handleSave}>
                        <Save className="w-3.5 h-3.5" />
                        Save Changes
                    </Button>
                </div>

                {saved && (
                    <Alert variant="success">Profile saved successfully.</Alert>
                )}

                <div className="grid lg:grid-cols-3 gap-6">
                    {/* Left column */}
                    <div className="space-y-4">
                        {/* Avatar + identity */}
                        <Card>
                            <CardContent className="p-6 text-center space-y-3">
                                <div className="relative inline-block">
                                    <Avatar
                                        name={fl.name}
                                        size="xl"
                                        className="mx-auto"
                                    />
                                    <button className="absolute bottom-0 right-0 w-7 h-7 rounded-full bg-primary text-primary-foreground flex items-center justify-center hover:bg-primary/90">
                                        <Pencil className="w-3 h-3" />
                                    </button>
                                </div>
                                <div>
                                    <h2 className="font-bold text-foreground">
                                        {fl.name}
                                    </h2>
                                    <p className="text-sm text-muted-foreground">
                                        {fl.email}
                                    </p>
                                    <div className="flex items-center justify-center gap-1.5 mt-2">
                                        <BadgeCheck className="w-4 h-4 text-primary" />
                                        <span className="text-xs text-primary font-semibold">
                                            Verified Freelancer
                                        </span>
                                    </div>
                                </div>
                                {fl.rating && (
                                    <div className="flex items-center justify-center gap-2 pt-1">
                                        <StarRating
                                            rating={fl.rating}
                                            showValue
                                        />
                                        <span className="text-xs text-muted-foreground">
                                            ({fl.reviewCount} reviews)
                                        </span>
                                    </div>
                                )}
                            </CardContent>
                        </Card>

                        {/* Stats */}
                        <div className="grid grid-cols-2 gap-3">
                            <StatCard
                                label="Completed"
                                value={fl.completedContracts}
                                icon={<Check className="w-4 h-4" />}
                            />
                            <StatCard
                                label="Hourly Rate"
                                value={
                                    fl.hourlyRate ? `$${fl.hourlyRate}/h` : "—"
                                }
                                icon={<DollarSign className="w-4 h-4" />}
                            />
                        </div>
                    </div>

                    {/* Right column */}
                    <div className="lg:col-span-2 space-y-4">
                        {/* Basic info */}
                        <Card>
                            <CardHeader>
                                <CardTitle>Basic Information</CardTitle>
                            </CardHeader>
                            <CardContent className="pt-4 space-y-4">
                                <EditableField
                                    label="Full Name"
                                    value={fl.name}
                                    onSave={(v) => updateFl("name", v)}
                                    icon={<User className="w-4 h-4" />}
                                />
                                <Separator />
                                <EditableField
                                    label="Email"
                                    value={fl.email}
                                    type="email"
                                    onSave={(v) => updateFl("email", v)}
                                    icon={<Mail className="w-4 h-4" />}
                                />
                                <Separator />
                                <EditableField
                                    label="Phone"
                                    value={fl.phone ?? ""}
                                    type="tel"
                                    onSave={(v) => updateFl("phone", v)}
                                    icon={<Phone className="w-4 h-4" />}
                                />
                                <Separator />
                                <EditableField
                                    label="Hourly Rate ($/hr)"
                                    value={fl.hourlyRate?.toString() ?? ""}
                                    type="number"
                                    onSave={(v) =>
                                        updateFl("hourlyRate", Number(v))
                                    }
                                    icon={<DollarSign className="w-4 h-4" />}
                                />
                                <Separator />
                                <EditableField
                                    label="Bio"
                                    value={fl.bio ?? ""}
                                    onSave={(v) => updateFl("bio", v)}
                                    multiline
                                    icon={<User className="w-4 h-4" />}
                                />
                            </CardContent>
                        </Card>

                        {/* Skills */}
                        <Card>
                            <CardHeader>
                                <CardTitle>Skills</CardTitle>
                            </CardHeader>
                            <CardContent className="pt-4">
                                <SkillsEditor
                                    skills={fl.skills}
                                    onChange={(s) => updateFl("skills", s)}
                                />
                            </CardContent>
                        </Card>

                        {/* Reviews */}
                        <Card>
                            <CardHeader>
                                <CardTitle>Reviews from Clients</CardTitle>
                            </CardHeader>
                            <CardContent className="pt-4 space-y-4">
                                {MOCK_REVIEWS.length === 0 ? (
                                    <p className="text-sm text-muted-foreground italic">
                                        No reviews yet.
                                    </p>
                                ) : (
                                    MOCK_REVIEWS.map((review) => (
                                        <div
                                            key={review.id}
                                            className="space-y-2"
                                        >
                                            <div className="flex items-center gap-2">
                                                <Avatar
                                                    name={review.reviewerName}
                                                    size="sm"
                                                />
                                                <div>
                                                    <p className="text-sm font-bold text-foreground">
                                                        {review.reviewerName}
                                                    </p>
                                                    <p className="text-xs text-muted-foreground">
                                                        {formatDate(
                                                            review.createdAt,
                                                        )}
                                                    </p>
                                                </div>
                                                <StarRating
                                                    rating={review.rating}
                                                />
                                            </div>
                                            {review.comment && (
                                                <p className="text-sm text-muted-foreground leading-relaxed italic pl-9">
                                                    &ldquo;{review.comment}
                                                    &rdquo;
                                                </p>
                                            )}
                                            <Separator />
                                        </div>
                                    ))
                                )}
                            </CardContent>
                        </Card>
                    </div>
                </div>
            </div>
        );
    }

    // CLIENT PROFILE
    return (
        <div className="space-y-6 max-w-4xl">
            <div className="flex items-start justify-between">
                <div>
                    <h1 className="text-2xl font-bold text-foreground">
                        Company Profile
                    </h1>
                    <p className="text-muted-foreground mt-1">
                        Visible to freelancers reviewing your projects.
                    </p>
                </div>
                <Button size="sm" onClick={handleSave}>
                    <Save className="w-3.5 h-3.5" />
                    Save Changes
                </Button>
            </div>

            {saved && (
                <Alert variant="success">Profile saved successfully.</Alert>
            )}

            <div className="grid lg:grid-cols-3 gap-6">
                <div className="space-y-4">
                    <Card>
                        <CardContent className="p-6 text-center space-y-3">
                            <Avatar
                                name={cl.name}
                                size="xl"
                                className="mx-auto"
                            />
                            <div>
                                <h2 className="font-bold text-foreground">
                                    {cl.name}
                                </h2>
                                {cl.companyName && (
                                    <p className="text-sm text-muted-foreground flex items-center justify-center gap-1 mt-0.5">
                                        <Building2 className="w-3.5 h-3.5" />
                                        {cl.companyName}
                                    </p>
                                )}
                                {cl.rating && (
                                    <div className="flex items-center justify-center gap-2 mt-2">
                                        <StarRating
                                            rating={cl.rating}
                                            showValue
                                        />
                                        <span className="text-xs text-muted-foreground">
                                            ({cl.reviewCount} reviews)
                                        </span>
                                    </div>
                                )}
                            </div>
                        </CardContent>
                    </Card>

                    <div className="grid grid-cols-2 gap-3">
                        <StatCard
                            label="Projects"
                            value={cl.totalProjectsPosted}
                            icon={<Briefcase className="w-4 h-4" />}
                        />
                        <StatCard
                            label="Contracts"
                            value={completedContracts.length}
                            icon={<Check className="w-4 h-4" />}
                        />
                    </div>
                </div>

                <div className="lg:col-span-2 space-y-4">
                    <Card>
                        <CardHeader>
                            <CardTitle>Account Details</CardTitle>
                        </CardHeader>
                        <CardContent className="pt-4 space-y-4">
                            <EditableField
                                label="Full Name"
                                value={cl.name}
                                onSave={(v) => updateCl("name", v)}
                                icon={<User className="w-4 h-4" />}
                            />
                            <Separator />
                            <EditableField
                                label="Email"
                                value={cl.email}
                                type="email"
                                onSave={(v) => updateCl("email", v)}
                                icon={<Mail className="w-4 h-4" />}
                            />
                            <Separator />
                            <EditableField
                                label="Phone"
                                value={cl.phone ?? ""}
                                type="tel"
                                onSave={(v) => updateCl("phone", v)}
                                icon={<Phone className="w-4 h-4" />}
                            />
                        </CardContent>
                    </Card>

                    <Card>
                        <CardHeader>
                            <CardTitle>Company Information</CardTitle>
                        </CardHeader>
                        <CardContent className="pt-4 space-y-4">
                            <EditableField
                                label="Company Name"
                                value={cl.companyName ?? ""}
                                onSave={(v) => updateCl("companyName", v)}
                                icon={<Building2 className="w-4 h-4" />}
                            />
                            <Separator />
                            <EditableField
                                label="Website"
                                value={cl.website ?? ""}
                                type="url"
                                onSave={(v) => updateCl("website", v)}
                                icon={<Globe className="w-4 h-4" />}
                            />
                            <Separator />
                            <EditableField
                                label="Company Description"
                                value={cl.companyDescription ?? ""}
                                onSave={(v) =>
                                    updateCl("companyDescription", v)
                                }
                                multiline
                                icon={<Building2 className="w-4 h-4" />}
                            />
                        </CardContent>
                    </Card>
                </div>
            </div>
        </div>
    );
}
